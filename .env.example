# ==============================================================================
# Veyra Environment Configuration (.env.example)
# All variables should use placeholder values. NEVER commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Arc Network & Chain Configuration (Arc Testnet)
# ------------------------------------------------------------------------------
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# ------------------------------------------------------------------------------
# 3. Database (Supabase)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_AGENT_DB_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_AGENT_DB_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
AGENT_DB_SUPABASE_URL=https://your-project.supabase.co
AGENT_DB_SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 4. Arc Proof Registry
# ------------------------------------------------------------------------------
AGENT_COMMERCE_PROOF_REGISTRY_ADDRESS=0x92dC1aFC126F755ba5d5254e8D697CAe10474851
AGENT_COMMERCE_PROOF_ATTESTER_PRIVATE_KEY=0xYourServerAttesterPrivateKey
PROOF_REGISTRY_OPERATOR_ADDRESS=0xYourOperatorAddress
PROOF_REGISTRY_ATTESTER_ADDRESS=0xYourServerAttesterAddress

# ------------------------------------------------------------------------------
# 5. Workflow Payments & Hosted Runner
# ------------------------------------------------------------------------------
HOSTED_AGENT_ADDRESS=0xYourHostedBuyerAddress
HOSTED_AGENT_PRIVATE_KEY=0xYourHostedBuyerPrivateKey
HOSTED_AGENT_RATE_LIMIT_SECRET=replace-with-a-long-random-server-secret
HOSTED_WORKFLOW_TREASURY_ADDRESS=0xYourWorkflowTreasuryAddress
HOSTED_WORKFLOW_PLATFORM_FEE_USDC=0.0007
HOSTED_WORKFLOW_MAX_PRICE_USDC=0.005
HOSTED_WORKFLOW_SPONSORED_QUOTA=1
HOSTED_WORKFLOW_QUOTE_EXPIRY_SECONDS=600

# ------------------------------------------------------------------------------
# 6. x402 Payments & Wallets
# ------------------------------------------------------------------------------
SELLER_ADDRESS=0xYourSellerAddress
SELLER_PRIVATE_KEY=0xYourSellerPrivateKey
BUYER_ADDRESS=0xYourBuyerAddress
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKey
NEXT_PUBLIC_DEMO_BUYER_ADDRESS=0xYourDemoBuyerAddress

# ------------------------------------------------------------------------------
# 7. ERC-8004 Agent Identity & Validation
# ------------------------------------------------------------------------------
ARC_ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ARC_ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
ARC_ERC8004_VALIDATION_REGISTRY=0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# ------------------------------------------------------------------------------
# 8. ERC-8183 Independent Evaluator
# ------------------------------------------------------------------------------
ARC_ERC8183_AGENTIC_COMMERCE_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
NEXT_PUBLIC_VEYRA_ERC8183_EVALUATOR_ADDRESS=0xYourDeployedEvaluatorAddress
ERC8183_EVALUATOR_ATTESTER_PRIVATE_KEY=0xYourAttesterPrivateKey
ERC8183_EVALUATOR_RELAYER_PRIVATE_KEY=0xYourRelayerPrivateKey
ERC8183_EVALUATOR_CANARY_ENABLED=false
ERC8183_EVALUATION_MAX_ARTIFACT_BYTES=1048576
ERC8183_EVALUATION_FETCH_TIMEOUT_MS=15000
ERC8183_VERDICT_MAX_VALIDITY_SECONDS=600

# ------------------------------------------------------------------------------
# 9. Veyra Trust Gate
# ------------------------------------------------------------------------------
VEYRA_TRUST_GATE_ADDRESS=0xYourTrustGateContractAddress
VEYRA_TRUST_ATTESTER_PRIVATE_KEY=0xYourTrustGateAttesterPrivateKey

# ------------------------------------------------------------------------------
# 10. Monitoring & Webhooks
# ------------------------------------------------------------------------------
MONITORING_SCHEDULER_SECRET=replace-with-a-random-scheduler-secret
WEBHOOK_SIGNING_SECRET=replace-with-a-random-webhook-signing-secret

# ------------------------------------------------------------------------------
# 11. Data Providers & APIs
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your-optional-github-personal-access-token
PYTH_API_KEY=your-optional-pyth-api-key

# ------------------------------------------------------------------------------
# 12. Optional LLM Synthesis
# ------------------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. The model never decides who
# gets paid: it writes the summary of a report from API responses that were
# already purchased. If it is absent or fails, the report falls back to the
# deterministic structured form and the workflow still completes.
#
# Pick a model that does not reason. Nova's daily pass asks for one rewritten
# sentence, and a reasoning model spends its whole budget getting there: measured
# on deepseek-v4-flash, 1233-3667 reasoning tokens for a 25-token question, 5-16s
# per call, response bodies of 5.6-15.2 KB against the 24 KB cap in
# lib/llm/openai-compatible.ts. Two in five calls then failed -- on the timeout,
# or as response_too_large, which is not retried -- and every failure reached the
# brief as a signal nobody could price. ministral-8b answers the same prompt in
# under a second with zero reasoning tokens and a 500-byte body.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=your-mistral-api-key
LLM_MODEL=ministral-8b-latest

# How the provider is named in published report metadata and in the sentence a
# report shows when synthesis failed. Unset, it reads "Unnamed provider" -- the
# default names no vendor on purpose, because a wrong name stated confidently is
# worse than an admitted gap.
LLM_PROVIDER_LABEL=Mistral

# Some routers reject a request whose User-Agent they do not recognise --
# AgentRouter answers 401 unauthorized_client_error without the exact value
# `cline/3.1.0`. Leave unset for providers that do not care, Mistral included.
# LLM_USER_AGENT=

# Nova's public-source reading is the one call that is judgement rather than a
# rewrite: twenty rules applied to an article against a goal and a stated
# project state, returning grounded JSON. It may name its own provider, and
# each setting below falls back to its plain counterpart above -- set none of
# them and nothing changes.
#
# Why it is separate, measured on five stored events against the production
# source set (the event plus the Arc and Circle reference pages -- three
# sources, not one; measuring with one flatters the smaller model):
#
# ministral-8b:  cited one of the owner's confirmed project facts in 0 of 14
#                usable runs, so the "what you already have" half of every
#                finding was empty by construction, and it called the owner's
#                main card significant only once in three.
# ministral-14b: cited one in 12 of 12, four of four on three subjects, 5.0s
#                median. Its cost is a lower significance bar -- an ecosystem
#                launch both other models held back passes 4 of 4 -- and one
#                subject whose citations never matched its sources, which the
#                grounding check rejects rather than shows.
#
# Do NOT point LLM_MODEL at a reasoning model to get more than this. The note
# above this block measured one on the one-sentence rewrite and it failed two
# calls in five. Two models, two workloads.
#
# Both Mistral models above share one defect that no prompt edition fixed.
# Asked whether "sponsored gas on Arc" bears on the owner's own confirmed
# "operational wallet not chosen", ministral-14b answered no six times out of
# six, reasoning that the owner had never written down the word "gas". That is
# matching on words, and it is why the reading model is a deepseek here.
LLM_READING_PROVIDER_LABEL=OpenRouter
LLM_READING_BASE_URL=https://openrouter.ai/api/v1
LLM_READING_API_KEY=your-openrouter-api-key
LLM_READING_MODEL=deepseek/deepseek-v4.1-flash

# Measured on the owner's six hardest stored cards, against ministral-14b:
#
# deepseek-v4.1-flash: makes the connection above; writes the best proposed
#                      work of any candidate (a wallet checklist quoting
#                      EIP-3085, one merged USDC balance, USDC fee labels);
#                      answers 10 of 12 and 8 of those in the goal's language.
# deepseek-v4-flash:   6x cheaper and answers about as often, but only 2 of 14
#                      answers came back in the goal's language and it stretched
#                      "decides" onto an unrelated asset once. A fine fallback.
# ministral-14b:       answers every time and never invents work; also never
#                      finds any. See above.
#
# Rejected, measured the same way: mistral-small-24b echoed these instructions
# back as its answer; qwen3-30b-a3b produced exactly the invented work that
# reading-rules edition 6 exists to stop; qwen3.5-flash and
# deepseek-v4-flash-0731 failed nearly every call.

# A router's own knob, merged into the request body. It can never displace the
# model, the messages or anything else this client sets.
#
# OpenRouter serves one model id from a dozen upstream providers and picks per
# request. Several do not implement response_format, so the JSON instruction is
# dropped, prose comes back, and the reading is thrown out as ungrounded -- a
# third of all calls, at random. This routes only to providers that implement
# what the request actually asks for, and took v4.1-flash from 8 of 12 to 10.
LLM_READING_EXTRA_BODY={"provider":{"require_parameters":true}}

# Before pointing these anywhere new: a router reached from a Vercel function
# is not the same as a router reached from a laptop. deepseek-v4-flash via
# agentrouter.org measured better than either Mistral model on every quality
# axis and was unusable in production -- that service sits behind Alibaba
# Cloud's firewall, which answers Vercel's egress addresses with an HTML
# challenge page at HTTP 200. Sixteen hours of readings failed. Verify from the
# deployment, not from a laptop.
# LLM_READING_USER_AGENT=cline/3.1.0

# Accepted as a fallback when LLM_API_KEY is unset, for environments that have
# not been migrated off the OpenRouter-specific name.
# OPENROUTER_API_KEY=your-openrouter-api-key
