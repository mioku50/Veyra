# ==============================================================================
# Veyra Environment Configuration (.env.example)
# All variables should use placeholder values. NEVER commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Arc Network & Chain Configuration (Arc Testnet)
# ------------------------------------------------------------------------------
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# ------------------------------------------------------------------------------
# 3. Database (Supabase)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_AGENT_DB_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_AGENT_DB_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
AGENT_DB_SUPABASE_URL=https://your-project.supabase.co
AGENT_DB_SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 4. Arc Proof Registry
# ------------------------------------------------------------------------------
AGENT_COMMERCE_PROOF_REGISTRY_ADDRESS=0x92dC1aFC126F755ba5d5254e8D697CAe10474851
AGENT_COMMERCE_PROOF_ATTESTER_PRIVATE_KEY=0xYourServerAttesterPrivateKey
PROOF_REGISTRY_OPERATOR_ADDRESS=0xYourOperatorAddress
PROOF_REGISTRY_ATTESTER_ADDRESS=0xYourServerAttesterAddress

# ------------------------------------------------------------------------------
# 5. Workflow Payments & Hosted Runner
# ------------------------------------------------------------------------------
HOSTED_AGENT_ADDRESS=0xYourHostedBuyerAddress
HOSTED_AGENT_PRIVATE_KEY=0xYourHostedBuyerPrivateKey
HOSTED_AGENT_RATE_LIMIT_SECRET=replace-with-a-long-random-server-secret
HOSTED_WORKFLOW_TREASURY_ADDRESS=0xYourWorkflowTreasuryAddress
HOSTED_WORKFLOW_PLATFORM_FEE_USDC=0.0007
HOSTED_WORKFLOW_MAX_PRICE_USDC=0.005
HOSTED_WORKFLOW_SPONSORED_QUOTA=1
HOSTED_WORKFLOW_QUOTE_EXPIRY_SECONDS=600

# ------------------------------------------------------------------------------
# 6. x402 Payments & Wallets
# ------------------------------------------------------------------------------
SELLER_ADDRESS=0xYourSellerAddress
SELLER_PRIVATE_KEY=0xYourSellerPrivateKey
BUYER_ADDRESS=0xYourBuyerAddress
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKey
NEXT_PUBLIC_DEMO_BUYER_ADDRESS=0xYourDemoBuyerAddress

# ------------------------------------------------------------------------------
# 7. ERC-8004 Agent Identity & Validation
# ------------------------------------------------------------------------------
ARC_ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ARC_ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
ARC_ERC8004_VALIDATION_REGISTRY=0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# ------------------------------------------------------------------------------
# 8. ERC-8183 Independent Evaluator
# ------------------------------------------------------------------------------
ARC_ERC8183_AGENTIC_COMMERCE_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
NEXT_PUBLIC_VEYRA_ERC8183_EVALUATOR_ADDRESS=0xYourDeployedEvaluatorAddress
ERC8183_EVALUATOR_ATTESTER_PRIVATE_KEY=0xYourAttesterPrivateKey
ERC8183_EVALUATOR_RELAYER_PRIVATE_KEY=0xYourRelayerPrivateKey
ERC8183_EVALUATOR_CANARY_ENABLED=false
ERC8183_EVALUATION_MAX_ARTIFACT_BYTES=1048576
ERC8183_EVALUATION_FETCH_TIMEOUT_MS=15000
ERC8183_VERDICT_MAX_VALIDITY_SECONDS=600

# ------------------------------------------------------------------------------
# 9. Veyra Trust Gate
# ------------------------------------------------------------------------------
VEYRA_TRUST_GATE_ADDRESS=0xYourTrustGateContractAddress
VEYRA_TRUST_ATTESTER_PRIVATE_KEY=0xYourTrustGateAttesterPrivateKey

# ------------------------------------------------------------------------------
# 10. Monitoring & Webhooks
# ------------------------------------------------------------------------------
MONITORING_SCHEDULER_SECRET=replace-with-a-random-scheduler-secret
WEBHOOK_SIGNING_SECRET=replace-with-a-random-webhook-signing-secret

# ------------------------------------------------------------------------------
# 11. Data Providers & APIs
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your-optional-github-personal-access-token
PYTH_API_KEY=your-optional-pyth-api-key

# ------------------------------------------------------------------------------
# 12. Optional LLM Synthesis
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
